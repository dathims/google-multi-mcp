# The .mcpb bundle only ships the compiled server, its dependencies, the manifest and the icon.
# Every rule is anchored at the root: a bare `src/` would also strip the code of the dependencies.
/src/
/.github/
/.impeccable/
/docs/
/Dockerfile
/.dockerignore
/tsconfig.json
/node_modules/typescript/
/node_modules/@types/
/*.mcpb
