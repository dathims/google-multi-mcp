{
  "name": "google-multi-mcp",
  "version": "1.0.0",
  "description": "Serveur MCP local donnant à Claude l'accès à plusieurs comptes Gmail, Google Calendar et Google Drive",
  "license": "MIT",
  "author": "OXYGENE NUMERIQUE (https://usecockpit.co)",
  "homepage": "https://plugin.usecockpit.co/google-multi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dathims/google-multi-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dathims/google-multi-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "gmail",
    "google-calendar",
    "google-drive",
    "multi-account"
  ],
  "type": "module",
  "private": true,
  "bin": {
    "google-multi-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "add-account": "node dist/cli.js add",
    "list-accounts": "node dist/cli.js list",
    "remove-account": "node dist/cli.js remove",
    "check-accounts": "node dist/cli.js check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "google-auth-library": "^11.2.0",
    "googleapis": "^185.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5"
  }
}
